      <column caption='Childern_media_count' datatype='integer' name='[Calculation_2814501701955585]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF { FIXED [country] :&#13;&#10;        SUM(&#13;&#10;            IF CONTAINS([listed_in], &quot;Children &amp; Family Movies&quot;) THEN 1 ELSE 0 END&#13;&#10;        )&#13;&#10;   } = 0&#13;&#10;THEN NULL&#13;&#10;ELSE&#13;&#10;   { FIXED [country] :&#13;&#10;        SUM(&#13;&#10;            IF CONTAINS([listed_in], &quot;Children &amp; Family Movies&quot;) THEN 1 ELSE 0 END&#13;&#10;        )&#13;&#10;   }&#13;&#10;END' />
      </column>
      <column caption='Childern_media_count (Date Added)' datatype='integer' name='[Calculation_2814501714071562]' role='measure' type='quantitative'>
